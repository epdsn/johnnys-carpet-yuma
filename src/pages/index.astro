---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Hero from '../components/Hero.astro'; import Gallery from '../components/Gallery.astro';

---
<Layout><Header/><main><Hero/>
<section class="bg-amber-500"><div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-stone-900/15 px-6 py-7 text-center md:grid-cols-4"><div><b class="text-2xl">50 Years</b><p class="text-sm">Serving Yuma</p></div><div><b class="text-2xl">Family Owned</b><p class="text-sm">Local since 1976</p></div><div><b class="text-2xl">Fair Prices</b><p class="text-sm">Options for your budget</p></div><div><b class="text-2xl">Local Service</b><p class="text-sm">People you can talk to</p></div></div></section>
<section id="difference" class="mx-auto max-w-7xl px-6 py-24"><div class="rounded-[2rem] bg-stone-200 p-10 md:p-16"><p class="font-bold uppercase tracking-widest text-amber-700">The Johnny's difference</p><h2 class="mt-3 max-w-3xl text-4xl font-black sm:text-5xl">Great floors don't have to cost a fortune.</h2><p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">We'll help you compare flooring options and find a solution that works for your home and your budget—without pushing you toward the most expensive product.</p></div></section>
<Gallery/>
<section id="reviews" class="bg-white"><div class="mx-auto max-w-7xl px-6 py-24 text-center"><p class="font-bold uppercase tracking-widest text-amber-700">Local reputation</p><h2 class="mt-3 text-4xl font-black sm:text-5xl">Yuma knows Johnny's.</h2><p class="mx-auto mt-6 max-w-2xl text-stone-600">Family owned since 1976, we're proud to help Yuma families find quality flooring at affordable prices.</p></div></section>
<section id="contact" class="bg-amber-500"><div class="mx-auto max-w-7xl px-6 py-20 text-center"><h2 class="text-4xl font-black sm:text-6xl">Ready for new floors?</h2><p class="mt-5 text-lg">Call Johnny's to talk about your flooring project.</p><div class="mt-8 flex flex-wrap justify-center gap-4"><a href="tel:+19287835085" class="rounded-full bg-stone-950 px-7 py-4 font-bold text-white">Call (928) 783-5085</a></div></div></section>
</main><footer class="bg-stone-950 px-6 py-10 text-center text-sm text-stone-500"><nav aria-label="Social media" class="mb-6 flex flex-wrap justify-center gap-4"><a href="https://www.facebook.com/JohnnysCarpetAZ/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-stone-600 px-5 py-3 font-semibold text-white transition-colors hover:border-amber-400 hover:text-amber-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-400" aria-label="Johnny's on Facebook (opens in a new tab)">Facebook ↗</a><a href="https://www.instagram.com/johnnys_carpet/" target="_blank" rel="noopener noreferrer" class="rounded-full border border-stone-600 px-5 py-3 font-semibold text-white transition-colors hover:border-amber-400 hover:text-amber-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-400" aria-label="Johnny's on Instagram (opens in a new tab)">Instagram ↗</a></nav>© {new Date().getFullYear()} Johnny's Carpet & Flooring • Yuma, Arizona<p class="mt-3 text-stone-400">Powered by <a href="https://www.omnir3.com" class="underline underline-offset-4 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-400">www.omnir3.com</a></p></footer></Layout>
