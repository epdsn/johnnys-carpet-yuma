---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Hero from '../components/Hero.astro';
const products=[['Carpet','Comfort and durability for bedrooms, living spaces and the whole home.'],['Luxury Vinyl Plank','Water-resistant, durable flooring with the look of natural wood.'],['Laminate & Vinyl','Practical flooring options designed for everyday life.'],['Professional Installation','Experienced installation from selection through the finished floor.']];
---
<Layout><Header/><main><Hero/>
<section class="bg-amber-500"><div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-stone-900/15 px-6 py-7 text-center md:grid-cols-4"><div><b class="text-2xl">50 Years</b><p class="text-sm">Serving Yuma</p></div><div><b class="text-2xl">Family Owned</b><p class="text-sm">Local since 1976</p></div><div><b class="text-2xl">Fair Prices</b><p class="text-sm">Options for your budget</p></div><div><b class="text-2xl">Local Service</b><p class="text-sm">People you can talk to</p></div></div></section>
<section id="flooring" class="mx-auto max-w-7xl px-6 py-24"><p class="font-bold uppercase tracking-widest text-amber-700">Flooring for every room</p><h2 class="mt-3 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl">Find the right floor for your home.</h2><div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{products.map(([name,desc],i)=><article class="group flex min-h-80 flex-col justify-end rounded-3xl bg-stone-900 p-7 text-white shadow-lg"><div class="mb-auto text-6xl font-black text-amber-500/25">0{i+1}</div><h3 class="text-2xl font-bold">{name}</h3><p class="mt-3 leading-7 text-stone-300">{desc}</p></article>)}</div></section>
<section id="about" class="bg-stone-900 text-white"><div class="mx-auto grid max-w-7xl gap-12 px-6 py-24 lg:grid-cols-2 lg:items-center"><div><p class="font-bold uppercase tracking-widest text-amber-400">Our story</p><h2 class="mt-3 text-5xl font-black tracking-tight">Family owned.<br/>Yuma proud.</h2></div><div><p class="text-xl leading-9 text-stone-300">Since 1976, Johnny's Carpet & Flooring has helped generations of Yuma families find flooring that fits their homes and their budgets.</p><p class="mt-6 leading-8 text-stone-400">We're a local business built around experience, straightforward advice and fair pricing. No big-box runaround—just help finding the floor that works for you.</p><p class="mt-8 text-2xl font-bold text-amber-400">Take care of people. Do good work. Charge a fair price.</p></div></div></section>
<section class="mx-auto max-w-7xl px-6 py-24"><div class="rounded-[2rem] bg-stone-200 p-10 md:p-16"><p class="font-bold uppercase tracking-widest text-amber-700">The Johnny's difference</p><h2 class="mt-3 max-w-3xl text-4xl font-black sm:text-5xl">Great floors don't have to cost a fortune.</h2><p class="mt-6 max-w-3xl text-lg leading-8 text-stone-700">We'll help you compare flooring options and find a solution that works for your home and your budget—without pushing you toward the most expensive product.</p></div></section>
<section id="reviews" class="bg-white"><div class="mx-auto max-w-7xl px-6 py-24 text-center"><p class="font-bold uppercase tracking-widest text-amber-700">Local reputation</p><h2 class="mt-3 text-4xl font-black sm:text-5xl">Yuma knows Johnny's.</h2><p class="mx-auto mt-6 max-w-2xl text-stone-600">Customer testimonials and recent project photos can be added here from Johnny's Facebook, Instagram and Google reviews.</p><div class="mt-10 text-4xl text-amber-500">★★★★★</div></div></section>
<section id="contact" class="bg-amber-500"><div class="mx-auto max-w-7xl px-6 py-20 text-center"><h2 class="text-4xl font-black sm:text-6xl">Ready for new floors?</h2><p class="mt-5 text-lg">Visit Johnny's in Yuma or call to talk about your project.</p><div class="mt-8 flex flex-wrap justify-center gap-4"><a href="tel:+19287834619" class="rounded-full bg-stone-950 px-7 py-4 font-bold text-white">Call (928) 783-4619</a><a href="https://maps.google.com/?q=1001+S+4th+Ave+Yuma+AZ+85364" class="rounded-full border-2 border-stone-950 px-7 py-4 font-bold">Get Directions</a></div><p class="mt-8 text-sm">1001 S 4th Ave • Yuma, AZ 85364</p></div></section>
</main><footer class="bg-stone-950 px-6 py-10 text-center text-sm text-stone-500">© {new Date().getFullYear()} Johnny's Carpet & Flooring • Yuma, Arizona</footer></Layout>
